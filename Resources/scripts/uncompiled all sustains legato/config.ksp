	declare lgt_dbg_ks  { temp debug scratch var, remove once legato is working }
	declare lgt_dbg_ir  { temp debug scratch var, remove once legato is working }

	{* LEGATO ENGINE (adapted from SIPS-Legato V2.05 by R.D. Villwock, aka 'Big Bob')
	   See the big comment above the function definitions in model.ksp for how the engine as a
	   whole works (the New/Old two-slot design). This block is just its tunable settings and
	   per-note state — nothing here runs any logic itself. *}

	declare const LGT_NO_ID := 0            { Sentinel meaning "no note here" — used for both parent/child IDs and real Kontakt event IDs never equal 0, so it's always safe to compare against }
	declare const LGT_TICK := 100           { How often (usec) the crossfade/bend loop in f.lgt_xfade() re-checks and updates — smaller = smoother fades but more CPU checks per crossfade }

	{* TEMP: live-tuning knobs, replacing the fixed consts above. Same variable names, so model.ksp
	   needs no changes. Values shown are raw microseconds (except Atk1Pct/BendEnable, which are
	   %/0-1) — remove this block and restore the plain `declare const` lines above once the
	   values are dialed in. Positions are fixed pixel coordinates (move_control_px), placed by
	   hand via Nico's own ui.control_knobs_action() tool. Row 1 (y=65/110): crossfade timing and
	   sample-start offset. Row 2 (y=155): pitch-bend glide controls. *}



	{* Two SIPS crossfade/bend parameters added 2026-11-25, missing from the original port. Both
	   are real Creator Tools controls on the SETTINGS panel - $SETTINGS_sli_legato_node_vol and
	   $SETTINGS_sli_legato_octave_x - so there is nothing to declare here; this note is just the
	   explanation of what they do, since neither is obvious from its name.

	   NODE VOL (SIPS 'NodeVol'), 10-100, the volume as a percent of full that fade-in segment 1
	   rises to before segment 2 takes over. The mechanism is not obvious: KSP's fade_in() always
	   ramps linearly to FULL volume, so to stop at NodeVol% you ask for a deliberately TOO LONG
	   fade - XTime*AtkFade/NodeVol - and interrupt it at AtkFade% of XTime, by which point the
	   ramp has reached exactly NodeVol%. Setting it to 100 reproduces the pre-2026-11-25
	   behaviour: segment 1 reaches full volume, so segment 2 is inaudible and the LEG ATTACK knob
	   only shortens the fade instead of shaping it.

	   OCT X (SIPS 'Octave X'), in tenths, the factor the bend amount is multiplied by at a
	   one-octave interval. 10 means x1.0 - an octave leap gets the SAME bend as a semitone, which
	   is SIPS's neutral setting. 120 reduces algebraically to the old code, which multiplied the
	   bend by the raw semitone count (x12 at an octave, i.e. 180 cents of glide at the default
	   15). A semitone is unaffected at any setting. *}

	declare const LGT_PHASE_GROUP_OFFSET := NUM_MICS*NUM_ARTICULATIONS  { group-index offset to the phase-aligned duplicate group set, added when $ADSR_swi_phase indicates phase-align is ON }
	declare lgt_phase_grp_ofs  { 0 or LGT_PHASE_GROUP_OFFSET, computed once per on note, added to every allow_group() group index }
	declare lgt_note_lo        { lowest in-range note across ALL selected articulations - set by f.update_art_selection_flags() }
	declare lgt_note_hi        { highest in-range note across ALL selected articulations - set by f.update_art_selection_flags() }
	declare any_harmonics_on   { 1 if ANY selected articulation is a harmonics one. Shift+click layering can select several at once, so this is what the note range and key colouring must read - NOT current_art, which only ever holds the last switch clicked }
	declare any_normal_on      { 1 if ANY selected articulation is a non-harmonics one }

	{* Per-note-event state. Everything here is sized [2] — one slot for "New" (the most recently
	   played note) and one for "Old" (whatever it's transitioning from). lgt.new_idx (0 or 1) says
	   which slot is currently "New"; the other index (1 - lgt.new_idx) is always "Old". See the
	   big comment at the top of the LEGATO ENGINE section in model.ksp for the full picture. *}
	family lgt
		declare parent[2]    { the REAL key-press event ID for each slot — used in on release to match a key-lift back to New or Old }
		declare child[2]     { the event ID of the note WE generated via play_note() — this is what actually makes sound, and what fade_in/fade_out/change_tune/note_off all act on }
		declare note[2]      { MIDI note number held in each slot }
		declare vel[2]       { velocity held in each slot }
		declare pedal[2]     { true if that slot's key-up arrived while the sustain pedal was down, and is waiting for pedal-up to actually end }
		declare tune[2]      { the bend amount (millicents) last applied to that slot's note, so f.lgt_do_bend() can apply the next tick as a delta rather than stacking }
		declare new_idx      { 0 or 1: which of the two slots above is currently "New" }
		declare ref_time     { ENGINE_UPTIME of the most recent note-on, for offset calc }
		declare offset       { sample-start offset to use for the next generated note, usec }
		declare fade_out_ticks
		declare fade_in_ticks
		declare seg2_ticks
		declare atk1_time    { fade-in segment 1 duration in usec, computed by f.lgt_setup_xfade() - see NODE VOL. Held here rather than recomputed in f.lgt_xfade() so the AtkFade=100 special case lives in one place }
		declare bend_ticks
		declare bend_amount
		declare bend_step
		declare active       { true while a crossfade is in progress }
		declare busy         { re-entrancy guard for f.lgt_stop_fade }
		declare pedal_down   { current sustain pedal state }
	end family

	lgt.parent[0] := LGT_NO_ID
	lgt.parent[1] := LGT_NO_ID
	lgt.pedal_down := false








end macro

