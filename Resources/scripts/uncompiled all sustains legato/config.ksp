import "ui_library_finished.ksp"

{/**
* Initialisation macro. Set up the UI, create some default variables and constants, setup global instrument parameters.
* 
* @param    title       Name for the script. If using multiple tabs this will also be displayed as the tab name in performance view.
* @param    ui_height   The height in pixels of the instrumnet UI. 
* @param    skin        The file name of the instrument's skin/wallpaper.
*}


