		 set_control_par_str(ui_output_labels[i], CONTROL_PAR_TEXT,  get_menu_item_str(ui_output_menus[i], get_control_par(ui_output_menus[i], CONTROL_PAR_VALUE)))
		//set_control_par(ui_id, control_parameter, value)
