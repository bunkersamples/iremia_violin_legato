	f.update_delay_controls()
	f.update_channel_controls()
	f.move_keyswitches($SETTINGS_sli_keyswitches)
	f.select_multi_articulation(current_art)
	f.update_keyswitch_notes_label($SETTINGS_sli_keyswitches)
	f.show_keyswitch_notes($SETTINGS_swi_show_keyswitch_notes)

	//set_knob_label($ADSR_A, get_engine_par_disp(ENGINE_PAR_ATTACK, 0, find_mod(0, "ENV_AHDSR"), find_target(0, find_mod(0, "ENV_AHDSR"), "ENV_AHDSR_VOLUME")))
	//set_knob_label($ADSR_D, get_engine_par_disp(ENGINE_PAR_DECAY, 0, find_mod(0, "ENV_AHDSR"), find_target(0, find_mod(0, "ENV_AHDSR"), "ENV_AHDSR_VOLUME")))
	//set_knob_label($ADSR_S, get_engine_par_disp(ENGINE_PAR_SUSTAIN, 0, find_mod(0, "ENV_AHDSR"), find_target(0, find_mod(0, "ENV_AHDSR"), "ENV_AHDSR_VOLUME")))
	//set_knob_label($ADSR_R, get_engine_par_disp(ENGINE_PAR_RELEASE, 0, find_mod(0, "ENV_AHDSR"), find_target(0, find_mod(0, "ENV_AHDSR"), "ENV_AHDSR_VOLUME")))
end on

on persistence_changed
	for i := 0 to NUM_MICS-1
		f.purge_mic_channel(i)
	end for

	//Restored switch value doesn't fire its own ui_control callback on load, so the label
	//needs the same sync done manually here.
	if $swi_legato_poly = 1
		set_text($lbl_legato_poly, "LEGATO")
	else
		set_text($lbl_legato_poly, "POLYPHONIC")
	end if
end on

on async_complete
    //if ($NI_ASYNC_ID = $load_ir_id)
    //    $load_ir_id := -1
    //    if ($NI_ASYNC_EXIT_STATUS = 0)
    //        message("IR sample not found!")
    //    else
    //        message("IR sample loaded!")
	//	end if 
	//end if
end on

on note

	if search(key_switches, EVENT_NOTE) # -1 //a key switch was pressed
		// f.select_articulation(search(key_switches, EVENT_NOTE))
		f.select_multi_articulation(search(key_switches, EVENT_NOTE))
	end if

	disallow_group(ALL_GROUPS)

	//LEGATO: decide which group SET this note plays through. Groups 0..104 are the normal
	//samples; groups 105..209 (LGT_PHASE_GROUP_OFFSET higher) are an exact duplicate set whose
	//zones have the per-mic phase-alignment correction (0/50/119/265/367 samples) baked directly
	//into their own Sample Start. lgt_phase_grp_ofs is just added to every allow_group() index
	//below so the SAME mic-enable logic naturally picks the right set — the legato engine itself
	//never needs to know mics or phase-alignment exist at all.
	if $ADSR_swi_phase # 1  //phase-align is currently ON: use the phase-aligned duplicate group set
		lgt_phase_grp_ofs := LGT_PHASE_GROUP_OFFSET
	else
		lgt_phase_grp_ofs := 0
	end if

	//Standard mic mute/solo group-enabling (pre-existing, unrelated to legato) — decides which
	//(mic x articulation) groups actually sound for this note. Legato's play_note() calls ride
	//on top of whatever's allowed here, same as a normal key press would.
	for a := 0 to NUM_MICS -1
		if ui_channel_swi_mute[a] -> VALUE = 1  //if channel Nr i is not muted
			if solo_on_flag = 0 //and no channels are solo'ed, allow the channel
				for b := 0 to num_elements(ui_art_switches)-1
					if get_control_par(ui_art_switches[b], CONTROL_PAR_VALUE) = 1
						allow_group(b*NUM_MICS + a + lgt_phase_grp_ofs)
					end if
				end for
			else if solo_channels[a] = 1 //else allow only solo's channels
				for b := 0 to num_elements(ui_art_switches)-1
					if get_control_par(ui_art_switches[b], CONTROL_PAR_VALUE) = 1
						allow_group(b*NUM_MICS + a + lgt_phase_grp_ofs)
					end if
				end for

			end if
		end if
	end for

	//LEGATO: harmonics use a different playable key range than the normal articulations
	//(LOWEST/HIGHEST_NOTE_HARMONICS vs ...NORMAL, see config.ksp), so which range counts as
	//"in range" for legato purposes has to cover everything currently selected. This used to
	//test current_art, which holds only the LAST switch clicked - so shift+click layering a
	//harmonic clamped the range to 78-108 and silently killed legato below note 78. The
	//function sets lgt_note_lo/hi to the union of all selected articulations' ranges, and also
	//sets any_harmonics_on / any_normal_on. See f.update_art_selection_flags() in model.ksp.
	f.update_art_selection_flags()

	//LEGATO: hand this note off to the engine — but only if $swi_legato_poly is on, and only for real
	//playable notes (not keyswitches, and within whichever note range applies above). When
	//$swi_legato_poly is off, none of this runs at all and the note just plays natively through
	//whatever groups were allowed above, exactly as if the legato engine didn't exist.
	//ignore_event() MUST be called here, directly in on note — it silently fails to suppress the
	//native note if called from inside a function instead (see the ksp-sublimeksp-gotchas memory
	//note). Once suppressed, f.lgt_process_note() takes over and decides whether this starts a
	//new phrase or continues a legato transition.
	if $swi_legato_poly = 1 and search(key_switches, EVENT_NOTE) = -1 and in_range(EVENT_NOTE, lgt_note_lo, lgt_note_hi)
		ignore_event(EVENT_ID)
		f.lgt_process_note()
	end if

end on

on release
	//LEGATO: figure out whether this key-lift ends the current phrase, ends an early-released
	//Old note, or (if the sustain pedal is down) just gets deferred — see f.lgt_release_note()
	//in model.ksp for the actual logic. Skipped entirely when $swi_legato_poly is off.
	if $swi_legato_poly = 1
		f.lgt_release_note()
	end if
end on

on controller
	//LEGATO: track the sustain pedal (CC64) so held legato phrases don't cut off while it's down.
	//When the pedal comes back up, f.lgt_test_pedal() finishes off anything that was deferred
	//by f.lgt_release_note() while it was held. Skipped entirely when $swi_legato_poly is off.
	if CC_NUM = 64 and $swi_legato_poly = 1 //sustain pedal
		if CC[64] < 64
			lgt.pedal_down := false
			f.lgt_test_pedal()
		else
			lgt.pedal_down := true
		end if
	end if
end on



