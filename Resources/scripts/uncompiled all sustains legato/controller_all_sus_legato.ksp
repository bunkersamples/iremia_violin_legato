on ui_control($swi_main)
	$swi_main := 1
	$swi_fx := 0
	$swi_settings := 0
	$mic_positions -> hide := HIDE_PART_NOTHING
	$ADSR -> hide := HIDE_PART_NOTHING
	$SEND_FX -> hide := HIDE_WHOLE_CONTROL
	$SETTINGS -> hide := HIDE_WHOLE_CONTROL	
end on

on ui_control($swi_fx)
	$swi_fx := 1
	$swi_main := 0
	$swi_settings := 0
	$mic_positions -> hide := HIDE_WHOLE_CONTROL
	$ADSR -> hide := HIDE_WHOLE_CONTROL
	$SEND_FX -> hide := HIDE_PART_NOTHING	
	$SETTINGS -> hide := HIDE_WHOLE_CONTROL	
	f.show_delay_controls($SEND_FX_mnu_delay_mode)
end on

on ui_control($swi_settings) //show settings panel
	$swi_settings := 1
	$swi_main := 0
	$swi_fx := 0
	$SETTINGS -> hide := HIDE_PART_NOTHING	
	$SEND_FX -> hide := HIDE_WHOLE_CONTROL	
	$mic_positions -> hide := HIDE_WHOLE_CONTROL
	$ADSR -> hide := HIDE_WHOLE_CONTROL
	// $mic_positions -> hide := HIDE_WHOLE_CONTROL
end on

//MIC POSITIONS ***** MIC POSITIONS ***** MIC POSITIONS ***** MIC POSITIONS ***** MIC POSITIONS ***** MIC POSITIONS ***** MIC POSITIONS ***** 

on ui_control($mic_positions_sli_inside)
	for i := 0 to NUM_ARTICULATIONS-1
		set_engine_par(ENGINE_PAR_VOLUME, $mic_positions_sli_inside, 0 + (NUM_MICS * i), -1, -1)
		set_engine_par(ENGINE_PAR_VOLUME, $mic_positions_sli_inside, 0 + (NUM_MICS * i) + LGT_PHASE_GROUP_OFFSET, -1, -1)  //phase-aligned duplicate set - without this the slider does nothing while align sample start is ON, since those are the groups that actually sound	
	end for
	f.update_label(0, 0, ENGINE_PAR_VOLUME, 0, -1, -1)
end on

on ui_control($mic_positions_sli_superclose)
	for i := 0 to NUM_ARTICULATIONS-1
		set_engine_par(ENGINE_PAR_VOLUME, $mic_positions_sli_superclose, 1 + (NUM_MICS * i), -1, -1)
		set_engine_par(ENGINE_PAR_VOLUME, $mic_positions_sli_superclose, 1 + (NUM_MICS * i) + LGT_PHASE_GROUP_OFFSET, -1, -1)  //phase-aligned duplicate set - without this the slider does nothing while align sample start is ON, since those are the groups that actually sound
	end for
	f.update_label(1,1, ENGINE_PAR_VOLUME, 1, -1, -1)
end on

