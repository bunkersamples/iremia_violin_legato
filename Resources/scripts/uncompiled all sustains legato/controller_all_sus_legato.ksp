		set_engine_par(ENGINE_PAR_VOLUME, $mic_positions_sli_close, 2 + (NUM_MICS * i) + LGT_PHASE_GROUP_OFFSET, -1, -1)  //phase-aligned duplicate set - without this the slider does nothing while align sample start is ON, since those are the groups that actually sound
	end for
	f.update_label(2,2, ENGINE_PAR_VOLUME, 2, -1, -1)
end on

