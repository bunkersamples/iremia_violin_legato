//end on

mic_channel_setting($mic_positions_panel_inside_par, $mic_positions_swi_inside_par, $mic_positions_panel_inside_par_swi_close, $mic_positions_panel_inside_par_swi_phase, $mic_positions_panel_inside_par_lbl_phase_on, $mic_positions_panel_inside_par_sli_stereo_width, $mic_positions_panel_inside_par_lbl_stereo_width, 0, $mic_positions_panel_inside_par_mnu_channel_output, $mic_positions_panel_inside_par_sli_delay_send, $mic_positions_panel_inside_par_sli_reverb_send, $mic_positions_panel_inside_par_sli_pan)
mic_channel_setting($mic_positions_panel_superclose_par, $mic_positions_swi_superclose_par, $mic_positions_panel_superclose_par_swi_close, $mic_positions_panel_superclose_par_swi_phase, $mic_positions_panel_superclose_par_lbl_phase_on, $mic_positions_panel_superclose_par_sli_stereo_width, $mic_positions_panel_superclose_par_lbl_stereo_width, 1, $mic_positions_panel_superclose_par_mnu_channel_output, $mic_positions_panel_superclose_par_sli_delay_send, $mic_positions_panel_superclose_par_sli_reverb_send, $mic_positions_panel_superclose_par_sli_pan)
mic_channel_setting($mic_positions_panel_close_par, $mic_positions_swi_close_par, $mic_positions_panel_close_par_swi_close, $mic_positions_panel_close_par_swi_phase, $mic_positions_panel_close_par_lbl_phase_on, $mic_positions_panel_close_par_sli_stereo_width, $mic_positions_panel_close_par_lbl_stereo_width, 2, $mic_positions_panel_close_par_mnu_channel_output, $mic_positions_panel_close_par_sli_delay_send, $mic_positions_panel_close_par_sli_reverb_send, $mic_positions_panel_close_par_sli_pan)
mic_channel_setting($mic_positions_panel_mid_par, $mic_positions_swi_mid_par, $mic_positions_panel_mid_par_swi_close, $mic_positions_panel_mid_par_swi_phase, $mic_positions_panel_mid_par_lbl_phase_on, $mic_positions_panel_mid_par_sli_stereo_width, $mic_positions_panel_mid_par_lbl_stereo_width, 3, $mic_positions_panel_mid_par_mnu_channel_output, $mic_positions_panel_mid_par_sli_delay_send, $mic_positions_panel_mid_par_sli_reverb_send, $mic_positions_panel_mid_par_sli_pan)
mic_channel_setting($mic_positions_panel_far_par, $mic_positions_swi_far_par, $mic_positions_panel_far_par_swi_close, $mic_positions_panel_far_par_swi_phase, $mic_positions_panel_far_par_lbl_phase_on, $mic_positions_panel_far_par_sli_stereo_width, $mic_positions_panel_far_par_lbl_stereo_width, 4, $mic_positions_panel_far_par_mnu_channel_output, $mic_positions_panel_far_par_sli_delay_send, $mic_positions_panel_far_par_sli_reverb_send, $mic_positions_panel_far_par_sli_pan)
{******************************************************************************************
* UI CALLBACKS *
******************************************************************************************}
{ui.control_knobs_action(knb_control name)}

macro mic_channel_setting(panel, swi_show, swi_close, swi_phase, lbl_phase, sli_stereo, lbl_stereo, num, output_menu, sli_delay, sli_reverb, sli_pan)
//SHOW AND HIDE PANEL  	SHOW AND HIDE PANEL  	SHOW AND HIDE PANEL  	SHOW AND HIDE PANEL  	
	on ui_control(swi_show)
		f.show_hide_panel(swi_show, get_ui_id(panel))
		//if other switches are 1, set that switch to 0 and call function agaon to close that panel
		for i := 0 to num_elements(ui_swi_mic_par)-1
			if get_control_par(ui_swi_mic_par[i], CONTROL_PAR_VALUE) = 1 and i # num //if panel is showing and not the switch the callback is coming from 
				f.show_hide_panel(0, ui_channel_panels[i]) //hide the other open panels
				set_control_par(ui_swi_mic_par[i], CONTROL_PAR_VALUE, 0) //set switch to 0
			end if
		end for
	end on

	on ui_control(swi_close)
		f.show_hide_panel(0, get_ui_id(panel))
		swi_show := 0
	end on


//SENDS ***** SENDS ***** SENDS ***** SENDS ***** SENDS ***** SENDS ***** SENDS ***** 
	
	on ui_control(sli_delay)
		set_engine_par(ENGINE_PAR_SENDLEVEL_0, sli_delay, -1, SEND_SLOT, NI_BUS_OFFSET + num)
		f.update_label(18 + num, 18 + num, ENGINE_PAR_SENDLEVEL_0, -1, SEND_SLOT, NI_BUS_OFFSET + num)
	end on

	on ui_control(sli_reverb)
		set_engine_par(ENGINE_PAR_SENDLEVEL_1, sli_reverb, -1, SEND_SLOT, NI_BUS_OFFSET + num)
		f.update_label(23 + num, 23 + num, ENGINE_PAR_SENDLEVEL_1, -1, SEND_SLOT, NI_BUS_OFFSET + num)
	end on


	on ui_control(sli_stereo)
		if num # 0 //if not inside mic	
			set_engine_par(ENGINE_PAR_STEREO, sli_stereo, -1, STEREO_SLOT, NI_BUS_OFFSET + num)
			f.update_label(12 + num, 12 + num, ENGINE_PAR_STEREO, -1, STEREO_SLOT, NI_BUS_OFFSET + num)
		end if
	end on

	on ui_control(sli_pan)
		if num # 0 
			set_engine_par(ENGINE_PAR_STEREO_PAN, sli_pan, -1, STEREO_SLOT, NI_BUS_OFFSET + num)
			f.update_label(44 + num, 44 + num, ENGINE_PAR_STEREO_PAN, -1, STEREO_SLOT, NI_BUS_OFFSET + num)
		else //inside mono mic
			set_engine_par(ENGINE_PAR_PAN, sli_pan, -1, -1, NI_BUS_OFFSET + num)
			f.update_label(44 + num, 44 + num, ENGINE_PAR_PAN, -1, STEREO_SLOT, NI_BUS_OFFSET + num)
		end if
	end on
//OUTPUT CHANNEL     OUTPUT CHANNEL     OUTPUT CHANNEL     OUTPUT CHANNEL     OUTPUT CHANNEL     OUTPUT CHANNEL     
	on ui_control(output_menu) //set the output of the busses
		set_engine_par(ENGINE_PAR_OUTPUT_CHANNEL, output_menu, -1, -1, NI_BUS_OFFSET + num)		
		set_control_par_str(ui_output_labels[num], CONTROL_PAR_TEXT,  get_menu_item_str(ui_output_menus[num], get_control_par(ui_output_menus[num], CONTROL_PAR_VALUE)))
	end on

end macro


