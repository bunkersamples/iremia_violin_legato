//show/hide dynamics parameters

on ui_control($ADSR_swi_dyn_par) //show panel
	f.show_hide_dynamic_settings($ADSR_swi_dyn_par)
	//if any mic setting panels are open, close it
	for i := 0 to num_elements(ui_swi_mic_par)-1
		f.show_hide_panel(0, ui_channel_panels[i]) //hide all mic par panels
		set_control_par(ui_swi_mic_par[i], CONTROL_PAR_VALUE, 0) //set mic par panel switches to 0
	end for 
end on

on ui_control($ADSR_panel_dyn_par_swi_close_dyn_par) //close the panel, set other switch to 0
	f.show_hide_dynamic_settings(0)
	//set_control_par(get_ui_id($ADSR_panel_dyn_par), CONTROL_PAR_HIDE, HIDE_WHOLE_CONTROL)
	$ADSR_swi_dyn_par := 0
end on

//global phase align

on ui_control($ADSR_swi_phase)
	{* Phase alignment is now handled by a duplicated set of groups with the phase correction baked into
	   each zone's native Sample Start (not S.Mod/modulation). This switch is read directly in on note
	   (lgt_phase_grp_ofs) to pick the normal or phase-aligned group set — it no longer drives any modulator. *}
	if $ADSR_swi_phase = 1
		set_text($ADSR_lbl_phase, "ALIGN S.START OFF")
	else
		set_text($ADSR_lbl_phase, "ALIGN S.START ON")
	end if

end on

on ui_control($swi_legato_poly)
	//Toggling legato off mid-phrase shouldn't leave a note hanging — cleanly end whatever the
	//engine currently has in flight before the bypass in on note/on release takes over. Toggling
	//back on needs no special handling: the next note-on just starts a fresh phrase normally.
	if $swi_legato_poly = 0
		f.lgt_end_phrase()
	end if

	if $swi_legato_poly = 1
		set_text($lbl_legato_poly, "LEGATO")
	else
		set_text($lbl_legato_poly, "POLYPHONIC")
	end if
end on

//LEGATO LABELS //LEGATO LABELS //LEGATO LABELS //LEGATO LABELS //LEGATO LABELS //LEGATO LABELS
