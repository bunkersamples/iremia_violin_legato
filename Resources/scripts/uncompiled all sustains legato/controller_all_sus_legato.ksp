//velocity sensitivity slider
on ui_control($ADSR_panel_dyn_par_sli_dyn_velocity)
	for i := 0 to NUM_GROUPS-1 
		set_engine_par(ENGINE_PAR_MOD_TARGET_INTENSITY, $ADSR_panel_dyn_par_sli_dyn_velocity, i, find_mod(i, "VEL->VOL"), -1)
