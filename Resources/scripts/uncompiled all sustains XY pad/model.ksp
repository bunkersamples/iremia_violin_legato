taskfunc f.color_keys()
	declare i
	for i := 0 to 127
		set_key_color(i, KEY_COLOR_INACTIVE)
	end for

	//for i := key_switches[0] to key_switches[0] + NUM_ARTICULATIONS -1 //color keyswitches
		//set_key_color(i, KEY_COLOR_RED)
	//end for

	f.update_harmonics_green_keys() //paints all of LOWEST_NOTE_NORMAL..HIGHEST_NOTE_HARMONICS (55-108) itself, in every branch, so the wipe above only has to clear what lies outside the playable range
end taskfunc

function f.update_harmonics_green_keys() //colours the keyboard to match what the four xy-pad corners can actually sound. Three zones: LOWEST_NOTE_NORMAL..LOWEST_NOTE_HARMONICS-1 (55-77) only the normal articulations reach, LOWEST_NOTE_HARMONICS..HIGHEST_NOTE_NORMAL (78-96) both families share, and past HIGHEST_NOTE_NORMAL (97-108) only harmonics reach. Every zone is repainted on every call, never left alone - this runs standalone from init and from the art_switches picker macro, not only via f.color_keys(), so a stale colour would otherwise stick when a corner changes family. Deliberately ignores the per-corner on/off switches: a corner switched off still colours the keyboard, by choice
	declare i
	declare any_harmonics
	declare any_normal
	any_harmonics := 0
	any_normal := 0

	for i := 0 to NUM_XY_CORNERS-1
		if xy_corner_art[i] = HARMONICS_CS or xy_corner_art[i] = HARMONICS_NORM
			any_harmonics := 1
		else
			any_normal := 1
		end if
	end for

	if any_normal = 1 //normal-only range: blue while any corner holds a normal articulation
		for i := LOWEST_NOTE_NORMAL to LOWEST_NOTE_HARMONICS-1
			set_key_color(i, KEY_COLOR_DEFAULT)
		end for
	else //every corner is harmonics, so nothing sounds down here - do not leave it blue promising notes it cannot play
		for i := LOWEST_NOTE_NORMAL to LOWEST_NOTE_HARMONICS-1
			set_key_color(i, KEY_COLOR_INACTIVE)
		end for
	end if

	if any_harmonics = 1 and any_normal = 1 //the overlap, and genuinely shared: its own colour
		for i := LOWEST_NOTE_HARMONICS to HIGHEST_NOTE_NORMAL
			set_key_color(i, KEY_COLOR_MINT)
		end for
	else
		if any_harmonics = 1 //all corners harmonics: this reads as harmonics range, not as an overlap
			for i := LOWEST_NOTE_HARMONICS to HIGHEST_NOTE_NORMAL
				set_key_color(i, KEY_COLOR_GREEN)
			end for
		else //no harmonics anywhere: plain normal range
			for i := LOWEST_NOTE_HARMONICS to HIGHEST_NOTE_NORMAL
				set_key_color(i, KEY_COLOR_DEFAULT)
			end for
		end if
	end if

	if any_harmonics = 1 //harmonics-only extension
		for i := HIGHEST_NOTE_NORMAL+1 to HIGHEST_NOTE_HARMONICS
			set_key_color(i, KEY_COLOR_GREEN)
		end for
	else
		for i := HIGHEST_NOTE_NORMAL+1 to HIGHEST_NOTE_HARMONICS
			set_key_color(i, KEY_COLOR_INACTIVE) //no corner uses harmonics, this extended range is out of reach again
		end for
	end if
end function

