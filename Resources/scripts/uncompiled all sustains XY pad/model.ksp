taskfunc f.update_label(label_num, parameter_num, parameter, group, slot, generic)
	declare local cb_state[NUM_LABELS]

	cb_state[label_num] := NI_CALLBACK_ID

	ui_labels[label_num] -> text := (!label_units_pre[parameter_num] & get_engine_par_disp(parameter, group, slot, generic) & !label_units_post[parameter_num])

	tcm.wait(LBL_WAIT_TIME)

	if cb_state[label_num] = NI_CALLBACK_ID //control hasn't been touched, reset text
		ui_labels[label_num] -> text := lbl_text[label_num]
	end if 

end taskfunc

taskfunc f.update_label_specific(label_num, control_num)
	declare local cb_state[NUM_LABELS]

	cb_state[label_num] := NI_CALLBACK_ID

	select control_num
		case 0 //dynamics simulation
			ui_labels[label_num] -> text := (!label_units_pre[label_num] & $ADSR_panel_dyn_par_sli_dyn_sim_int/100 & !label_units_post[label_num])
		case 1 //dynamics range
			ui_labels[label_num] -> text := (!label_units_pre[label_num] & $ADSR_panel_dyn_par_sli_dyn_range/10000 & !label_units_post[label_num])
	end select


	tcm.wait(LBL_WAIT_TIME)

	if cb_state[label_num] = NI_CALLBACK_ID //control hasn't been touched, reset text
		ui_labels[label_num] -> text := lbl_text[label_num]
	end if 

end taskfunc

taskfunc f.show_hide_dynamic_settings(value)  //if value = 1 -> show panel
	if value = 1
		set_control_par(get_ui_id($ADSR_panel_dyn_par), CONTROL_PAR_HIDE, HIDE_PART_NOTHING)
	else 
		set_control_par(get_ui_id($ADSR_panel_dyn_par), CONTROL_PAR_HIDE, HIDE_WHOLE_CONTROL)
	end if
end taskfunc

taskfunc f.show_hide_panel(value, panel) //if value = 1 -> show panel, else hide panel. Panel is ui_id 
	if value = 1
		set_control_par(panel, CONTROL_PAR_HIDE, HIDE_PART_NOTHING)
	else 
		set_control_par(panel, CONTROL_PAR_HIDE, HIDE_WHOLE_CONTROL)
	end if
end taskfunc

taskfunc f.show_delay_controls(value)
	declare i 
	for i := 0 to num_elements(ui_delay_modern)-1
		set_control_par(ui_delay_modern[i], CONTROL_PAR_HIDE, HIDE_WHOLE_CONTROL)
		set_control_par(ui_delay_analogue[i], CONTROL_PAR_HIDE, HIDE_WHOLE_CONTROL)
		set_control_par(ui_delay_tape[i], CONTROL_PAR_HIDE, HIDE_WHOLE_CONTROL)
		set_control_par(ui_delay_vintage[i], CONTROL_PAR_HIDE, HIDE_WHOLE_CONTROL)
		set_control_par(ui_delay_diffusion[i], CONTROL_PAR_HIDE, HIDE_WHOLE_CONTROL)

		select value 
			case 0 
				set_control_par(ui_delay_modern[i], CONTROL_PAR_HIDE, HIDE_PART_NOTHING)
				set_control_par(ui_delay_modern[1], CONTROL_PAR_HIDE, HIDE_PART_BG)
				set_control_par(ui_delay_modern[3], CONTROL_PAR_HIDE, HIDE_PART_BG)
				set_control_par(ui_delay_modern[5], CONTROL_PAR_HIDE, HIDE_PART_BG)
			case 1 
				set_control_par(ui_delay_analogue[i], CONTROL_PAR_HIDE, HIDE_PART_NOTHING)
				set_control_par(ui_delay_analogue[1], CONTROL_PAR_HIDE, HIDE_PART_BG)
				set_control_par(ui_delay_analogue[3], CONTROL_PAR_HIDE, HIDE_PART_BG)
				set_control_par(ui_delay_analogue[5], CONTROL_PAR_HIDE, HIDE_PART_BG)
			case 2 
				set_control_par(ui_delay_tape[i], CONTROL_PAR_HIDE, HIDE_PART_NOTHING)
				set_control_par(ui_delay_tape[1], CONTROL_PAR_HIDE, HIDE_PART_BG)
				set_control_par(ui_delay_tape[3], CONTROL_PAR_HIDE, HIDE_PART_BG)
				set_control_par(ui_delay_tape[5], CONTROL_PAR_HIDE, HIDE_PART_BG)
			case 3 
				set_control_par(ui_delay_vintage[i], CONTROL_PAR_HIDE, HIDE_PART_NOTHING)
				set_control_par(ui_delay_vintage[1], CONTROL_PAR_HIDE, HIDE_PART_BG)
				set_control_par(ui_delay_vintage[3], CONTROL_PAR_HIDE, HIDE_PART_BG)
				set_control_par(ui_delay_vintage[5], CONTROL_PAR_HIDE, HIDE_PART_BG)
			case 4 
				set_control_par(ui_delay_diffusion[i], CONTROL_PAR_HIDE, HIDE_PART_NOTHING)
				set_control_par(ui_delay_diffusion[1], CONTROL_PAR_HIDE, HIDE_PART_BG)
				set_control_par(ui_delay_diffusion[3], CONTROL_PAR_HIDE, HIDE_PART_BG)
				set_control_par(ui_delay_diffusion[5], CONTROL_PAR_HIDE, HIDE_PART_BG)
		end select
	end for 
end taskfunc

taskfunc f.update_delay_controls()
	declare i 
	for i := 0 to num_elements(delay_par) -1
		set_control_par(delay_controls[i], CONTROL_PAR_VALUE, get_engine_par(delay_par[i], -1, SEND_DELAY_SLOT, NI_SEND_BUS))
	end for
end taskfunc

taskfunc f.update_channel_controls()
	declare i 
	for i := 0 to num_elements(ui_delay_sends)-1
		set_control_par(ui_delay_sends[i], CONTROL_PAR_VALUE, get_engine_par(ENGINE_PAR_SENDLEVEL_0, -1, SEND_SLOT, NI_BUS_OFFSET + i))
		set_control_par(ui_reverb_sends[i], CONTROL_PAR_VALUE, get_engine_par(ENGINE_PAR_SENDLEVEL_1, -1, SEND_SLOT, NI_BUS_OFFSET + i))
		set_control_par(ui_stereo_controls[i], CONTROL_PAR_VALUE, get_engine_par(ENGINE_PAR_STEREO, -1, STEREO_SLOT, NI_BUS_OFFSET + i))
		if i = 0 //if inside mono mic
			set_control_par(ui_pan_controls[i], CONTROL_PAR_VALUE, get_engine_par(ENGINE_PAR_PAN, -1, -1, NI_BUS_OFFSET + i))
		else 
			set_control_par(ui_pan_controls[i], CONTROL_PAR_VALUE, get_engine_par(ENGINE_PAR_STEREO_PAN, -1, STEREO_SLOT, NI_BUS_OFFSET + i))
		end if
	end for
end taskfunc





