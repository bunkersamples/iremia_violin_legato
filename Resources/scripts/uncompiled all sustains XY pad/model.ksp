function f.purge_mic_channel(channel_num)
	declare i
	for c := 0 to NUM_XY_CORNERS-1
		for i := 0 to NUM_ARTICULATIONS-1
			if get_control_par(ui_channel_swi_mute[channel_num], CONTROL_PAR_VALUE) = 1 //if mute is ON, purge samples
				purge_group(xy_corner_group_start[c] + channel_num + (NUM_MICS*i), 1)
			else //mute is OFF, load samples
				purge_group(xy_corner_group_start[c] + channel_num + (NUM_MICS*i), 0)
			end if
		end for
	end for
end function

function f.update_xy_corner_labels() //set each xy-pad corner button AND its in-pad corner label to the name of that corner's assigned articulation, or "OFF" while the corner is switched off. Button gets the full name, label the shortened one.
	declare i
	for i := 0 to NUM_XY_CORNERS-1
		if ui_xy_corner_on_switches[i] -> VALUE = 1
			set_control_par_str(ui_xy_art_buttons[i], CONTROL_PAR_TEXT, !articulation_names[xy_corner_art[i]])
			set_control_par_str(ui_xy_corner_labels[i], CONTROL_PAR_TEXT, !articulation_names_short[xy_corner_art[i]])
		else
			set_control_par_str(ui_xy_art_buttons[i], CONTROL_PAR_TEXT, " OFF") //xy_corner_art[i] is deliberately left alone, so the articulation comes back when the corner is switched on again
			set_control_par_str(ui_xy_corner_labels[i], CONTROL_PAR_TEXT, "OFF")
		end if
	end for
end function

function f.update_xy_crossfade() //push each corner's current weight (blend of linear and equal-power, per $XY_pwr_blend) to its dead MIDI CC, which drives that corner's native Group Volume modulator (CC_VOLUME_CORNER_<n>)
	declare ~x
	declare ~y
	declare ~half_pi := 1.5707963
	declare ~blend //0.0-1.0 version of XY_BLEND_FIXED
	declare ?w_lin[NUM_XY_CORNERS]
	declare ?w_pow[NUM_XY_CORNERS]
	declare ?w[NUM_XY_CORNERS]
	declare trim_raw //raw 0-1000000 value of whichever corner's trim knob is current
	declare ~trim_min_db
	declare ~trim_pct
	declare ~trim_range
	declare ~trim_db
	declare ~trim_lin
	declare cc_val

	~x := ?xy_pad_xypad[0] //ui_xy's native range is 0.0-1.0, no scaling needed
	~y := ?xy_pad_xypad[1]
	~blend := int_to_real(XY_BLEND_FIXED) / 1000.0  //hard-coded in config.ksp 2026-11-26; was $XY_pwr_blend, the dev slider, which is now hidden and no longer drives anything

	//linear weights sum to exactly 1.0 everywhere (equal-gain, correct for correlated corner content); per-axis sin/cos weights multiplied together sum-of-squares to exactly 1.0 everywhere (equal-power, correct for decorrelated content). Real corner recordings sit somewhere between the two depending on how similar each corner pair sounds, so blend between them by ear via $XY_pwr_blend (TEMP dev knob, see config.ksp) rather than committing to one fixed law.
	?w_lin[0] := (1.0-~x) * (1.0-~y) //corner 1: bottom-left
	?w_lin[1] := (1.0-~x) * ~y       //corner 2: top-left
	?w_lin[2] := ~x * ~y             //corner 3: top-right
	?w_lin[3] := ~x * (1.0-~y)       //corner 4: bottom-right

	?w_pow[0] := cos(~x*~half_pi) * cos(~y*~half_pi) //corner 1: bottom-left
	?w_pow[1] := cos(~x*~half_pi) * sin(~y*~half_pi) //corner 2: top-left
	?w_pow[2] := sin(~x*~half_pi) * sin(~y*~half_pi) //corner 3: top-right
	?w_pow[3] := sin(~x*~half_pi) * cos(~y*~half_pi) //corner 4: bottom-right

	for c := 0 to NUM_XY_CORNERS-1
		?w[c] := ?w_lin[c] + ~blend*(?w_pow[c] - ?w_lin[c])

		//per-corner trim ($xy_pad_sli_trim_1..4), 0-1000000 -> 0 to -XY_TRIM_RANGE_DB (cut only, see config.ksp) -> linear multiplier, folded into the weight BEFORE it becomes a single CC value - not a second modulator on the same Group Volume target, since Kontakt sums (not multiplies) multiple modulator assignments on one target. Same reasoning as the X*Y combination above.
		select c
			case 0
				trim_raw := $xy_pad_sli_trim_1
			case 1
				trim_raw := $xy_pad_sli_trim_2
			case 2
				trim_raw := $xy_pad_sli_trim_3
			case 3
				trim_raw := $xy_pad_sli_trim_4
		end select
		//computed inline rather than via ui.remap_scale() - that function's return type checks inconsistently between a direct assignment and a nested call in this compiler, no cast combination satisfied both. One operation per line, chaining several binary operators in one statement also errored.
		~trim_min_db := 0.0 - ~XY_TRIM_RANGE_DB
		~trim_pct := int_to_real(trim_raw) / 1000000.0 //0.0-1.0
		~trim_range := 0.0 - ~trim_min_db //positive width, e.g. 24.0
		~trim_db := ~trim_pct * ~trim_range //0.0 to +range
		~trim_db := ~trim_db + ~trim_min_db //shift down into -range..0
		~trim_lin := pow(10.0, ~trim_db/20.0)
		?w[c] := ?w[c] * ~trim_lin

		cc_val := real_to_int(ui.remap_scale(?w[c], 0.0, 1.0, 0.0, 127.0)) //0.0-1.0 weight -> 0-127 MIDI CC range; real_to_int, not int() - matches the cast fn used everywhere else in this codebase

		//ui.remap_scale doesn't clamp, and a corner at/near full weight plus a positive trim can push ?w[c] above 1.0 - clamp here so set_controller never receives an out-of-range CC value
		if cc_val > 127
			cc_val := 127
		else if cc_val < 0
			cc_val := 0
		end if

		set_controller(XY_CORNER_BASE_CC + c, cc_val)
	end for
end function

function f.xy_cc_is_learnable(cc) -> return //1 only for CC numbers that actually appear in the assignment menus
	declare j
	return := 0
	//CC_NUM does not only carry MIDI CCs - it also reports $VCC_PITCH_BEND and $VCC_MONO_AT, which sit outside 0-127 and must never be captured.
	if cc >= 0 and cc <= 127
		return := 1
		//same exclusion list the menus are built from, so learn can never assign something the menu cannot display. This is also what makes the feature safe regardless of whether set_controller() re-enters this callback: the dead CCs 104-107 that f.update_xy_crossfade() writes are excluded, so nudging the pad while armed can never teach one.
		for j := 0 to XY_CC_NUM_EXCLUDED-1
			if cc = xy_cc_excluded[j]
				return := 0
			end if
		end for
	end if
end function

taskfunc f.xy_learn_blink(axis) //flash the armed learn switch until it is disarmed, either by capturing a CC or by being clicked again
	declare local cb_state[2]
	declare local lamp[2]

	cb_state[axis] := NI_CALLBACK_ID //same "am I still the current task?" trick as f.update_label_specific(): a newer invocation overwrites this, so the task it replaced stops on its next tick instead of fighting it
	lamp[axis] := 1

	while xy_cc_learn_axis = axis and cb_state[axis] = NI_CALLBACK_ID
		set_control_par(ui_xy_cc_learn_switches[axis], CONTROL_PAR_VALUE, lamp[axis])
		lamp[axis] := 1 - lamp[axis]
		tcm.wait(XY_LEARN_BLINK_TIME)
	end while

	if cb_state[axis] = NI_CALLBACK_ID //only the newest task clears the lamp, so a quick disarm-then-rearm doesn't get switched off by the task it replaced
		set_control_par(ui_xy_cc_learn_switches[axis], CONTROL_PAR_VALUE, 0)
	end if
end taskfunc

taskfunc f.update_xy_trim_label(corner_idx) //show the corner's current trim in dB, then revert to "TRIM" if untouched for LBL_WAIT_TIME - same show/revert debounce idiom as f.update_label_specific()
	declare local cb_state[NUM_XY_CORNERS]
	declare trim_raw
	declare db_cut_x10

	cb_state[corner_idx] := NI_CALLBACK_ID

	select corner_idx
		case 0
			trim_raw := $xy_pad_sli_trim_1
		case 1
			trim_raw := $xy_pad_sli_trim_2
		case 2
			trim_raw := $xy_pad_sli_trim_3
		case 3
			trim_raw := $xy_pad_sli_trim_4
	end select

	//raw -> dB is LINEAR here (the pow()/log only enters in the gain path in f.update_xy_crossfade), so the dB display needs no real arithmetic at all - which is why this now shows dB rather than the % it used to. +500000 rounds to nearest tenth; max intermediate is 240500000, well inside KSP's signed 32-bit int range.
	db_cut_x10 := XY_TRIM_RANGE_DB_X10 - (trim_raw*XY_TRIM_RANGE_DB_X10 + 500000)/1000000 //tenths of a dB of CUT, 240 (knob at 0) down to 0 (knob at max/neutral) - kept positive so the minus sign can be prepended as text, avoiding any reliance on how mod treats negatives

	if db_cut_x10 = 0
		@xy_trim_text := "0.0 dB"
	else
		@xy_trim_text := "-" & db_cut_x10/10 & "." & db_cut_x10 mod 10 & " dB" //same integer div + mod one-decimal idiom as the reverb lowcut/hicut labels in controller_all_sus.ksp
	end if

	select corner_idx
		case 0
			set_text($xy_pad_lbl_trim_1, @xy_trim_text)
		case 1
			set_text($xy_pad_lbl_trim_2, @xy_trim_text)
		case 2
			set_text($xy_pad_lbl_trim_3, @xy_trim_text)
		case 3
			set_text($xy_pad_lbl_trim_4, @xy_trim_text)
	end select

	tcm.wait(LBL_WAIT_TIME)

	if cb_state[corner_idx] = NI_CALLBACK_ID //control hasn't been touched again, reset text
		select corner_idx
			case 0
				set_text($xy_pad_lbl_trim_1, "TRIM")
			case 1
				set_text($xy_pad_lbl_trim_2, "TRIM")
			case 2
				set_text($xy_pad_lbl_trim_3, "TRIM")
			case 3
				set_text($xy_pad_lbl_trim_4, "TRIM")
		end select
	end if
end taskfunc

