on note 

	// message(EVENT_NOTE)
	//if search(key_switches, EVENT_NOTE) # -1 //a key switch was pressed
		//// f.select_articulation(search(key_switches, EVENT_NOTE))
		//f.select_multi_articulation(search(key_switches, EVENT_NOTE))
	//end if

	disallow_group(ALL_GROUPS)

	for a := 0 to NUM_MICS -1
		if ui_channel_swi_mute[a] -> VALUE = 1  //if channel Nr i is not muted
			if solo_on_flag = 0 //and no channels are solo'ed, allow the channel
				for c := 0 to NUM_XY_CORNERS-1 //allow each ENABLED corner's assigned articulation from its own duplicated group block; the corner's dead-CC modulator decides how loud it is. Skipping a disabled corner here means it never starts voices at all, rather than playing silently - that is the point of the switch (polyphony and CPU), and it is also why already-sounding notes ring out rather than cutting, since allow_group only affects new notes.
					if ui_xy_corner_on_switches[c] -> VALUE = 1
						allow_group(xy_corner_group_start[c] + xy_corner_art[c]*NUM_MICS + a)
					end if
				end for
			else if solo_channels[a] = 1 //else allow only solo's channels
				for c := 0 to NUM_XY_CORNERS-1
					if ui_xy_corner_on_switches[c] -> VALUE = 1
						allow_group(xy_corner_group_start[c] + xy_corner_art[c]*NUM_MICS + a)
					end if
				end for

			end if
		end if
	end for

end on

on release 

end on



