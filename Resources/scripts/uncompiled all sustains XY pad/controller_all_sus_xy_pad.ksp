// ui.control_knobs_action($xy_pad_lbl_art_control)

on ui_control(?xy_pad_xypad)
	f.update_xy_crossfade()
end on

on controller
	if xy_cc_learn_axis # -1
		//LEARN armed: capture the next usable CC into that axis's menu instead of moving the pad. Deliberately does NOT drive the axis on this event - otherwise the cursor would snap to wherever the knob happened to be sitting at the moment it was taught.
		xy_cc_learnable := f.xy_cc_is_learnable(CC_NUM)
		if xy_cc_learnable = 1
			if xy_cc_learn_axis = 0
				$xy_pad_mnu_cc_x := CC_NUM //menu item values ARE the CC numbers, so this selects the matching entry
			else
				$xy_pad_mnu_cc_y := CC_NUM
			end if
			xy_cc_learn_axis := -1 //captured - f.xy_learn_blink() sees this and clears the lamp
		end if
	else
		//MIDI CC control of the pad - the customer assigns a CC per axis via $xy_pad_mnu_cc_x/_y (see config.ksp for why menus replace right-click MIDI learn here). "OFF" is -1 and CC_NUM is never -1, so an unassigned axis simply never matches.
		//A script write to ?xy_pad_xypad[] does NOT fire the pad's own on ui_control, so f.update_xy_crossfade() has to be called explicitly - once, even if the same CC is assigned to both axes.
		if CC_NUM = $xy_pad_mnu_cc_x
			?xy_pad_xypad[0] := int_to_real(CC[CC_NUM]) / 127.0
		end if
		if CC_NUM = $xy_pad_mnu_cc_y
			?xy_pad_xypad[1] := int_to_real(CC[CC_NUM]) / 127.0
		end if
		if CC_NUM = $xy_pad_mnu_cc_x or CC_NUM = $xy_pad_mnu_cc_y
			f.update_xy_crossfade()
		end if
	end if
end on

//clicking an armed learn switch cancels; clicking the other one moves the arming over, and the abandoned blink task clears its own lamp on its next tick. The switch's own value is ignored because the blink drives it - xy_cc_learn_axis is the real state.
on ui_control($xy_pad_swi_cc_learn_x)
	if xy_cc_learn_axis = 0
		xy_cc_learn_axis := -1
	else
		xy_cc_learn_axis := 0
	end if
	f.xy_learn_blink(0) //called even when disarming: the task exits immediately and clears the lamp
end on

on ui_control($xy_pad_swi_cc_learn_y)
	if xy_cc_learn_axis = 1
		xy_cc_learn_axis := -1
	else
		xy_cc_learn_axis := 1
	end if
	f.xy_learn_blink(1)
end on

on ui_control($XY_pwr_blend) //TEMP dev knob - live-refresh the weights at the pad's current position so the blend amount can be heard without moving the pad
	f.update_xy_crossfade()
end on

on ui_control($xy_pad_sli_trim_1) //live-refresh at the pad's current position so each corner's trim can be balanced against the others without moving the cursor
	f.update_xy_crossfade()
	f.update_xy_trim_label(0)
end on

