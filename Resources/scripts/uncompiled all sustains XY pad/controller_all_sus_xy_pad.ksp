//DYNAMICS SETTINGS ***** DYNAMICS SETTINGS ***** DYNAMICS SETTINGS ***** DYNAMICS SETTINGS ***** DYNAMICS SETTINGS ***** DYNAMICS SETTINGS ***** DYNAMICS SETTINGS ***** DYNAMICS SETTINGS ***** 

on ui_control($ADSR_panel_dyn_par_sli_dyn_sim_int) //filter intensity
	if $ADSR_panel_dyn_par_sli_dyn_sim_int > 0 
		dyn_sim_moved_flag := 1
	else if $ADSR_panel_dyn_par_sli_dyn_sim_int = 0 
		dyn_sim_moved_flag := 0
	end if 

	dyn_sim_scaled := ($ADSR_panel_dyn_par_sli_dyn_sim_int - 0) * (7000 - 0) / (10000 - 0) + 0 
	for i := 0 to NUM_GROUPS -1 
		set_engine_par(ENGINE_PAR_MOD_TARGET_INTENSITY, dyn_sim_scaled * 100, i, find_mod(i, "EQ1_GAIN"), -1)
		if dyn_sim_moved_flag = 1
			set_engine_par(ENGINE_PAR_EFFECT_BYPASS, 0, i, 0, NI_INSERT_BUS)
		else 
			set_engine_par(ENGINE_PAR_EFFECT_BYPASS, 1, i, 0, NI_INSERT_BUS)
		end if
	end for
	f.update_label_specific(9, 0)
end on

on ui_control($ADSR_panel_dyn_par_sli_dyn_range) //range of dynamics 
	for i := 0 to NUM_GROUPS -1 
		set_engine_par(ENGINE_PAR_MOD_TARGET_INTENSITY, $ADSR_panel_dyn_par_sli_dyn_range, i, find_mod(i, "CC->DYN_RANGE"), -1)
	end for
	f.update_label_specific(10, 1)
end on

