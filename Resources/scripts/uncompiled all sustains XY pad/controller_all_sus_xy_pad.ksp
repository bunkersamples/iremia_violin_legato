// REVERB CONTROLS **** REVERB CONTROLS **** REVERB CONTROLS **** REVERB CONTROLS **** REVERB CONTROLS **** REVERB CONTROLS **** 

on ui_control($SEND_FX_swi_reverb_on)
	set_engine_par(ENGINE_PAR_SEND_EFFECT_BYPASS, 1-$SEND_FX_swi_reverb_on, -1, SEND_REVERB_SLOT, NI_SEND_BUS)
end on

on ui_control($SEND_FX_mnu_reverb_IR)
	if $SEND_FX_mnu_reverb_IR # -1
    	$load_ir_id := load_ir_sample(!IR_names[$SEND_FX_mnu_reverb_IR] , SEND_REVERB_SLOT, NI_SEND_BUS)
    	current_ir := $SEND_FX_mnu_reverb_IR
	else 
		$SEND_FX_mnu_reverb_IR := current_ir
 	end if
end on

on ui_control($SEND_FX_sli_reverb_lowcut)

	reverb_cb_state[0] := NI_CALLBACK_ID

  	~val := int_to_real($SEND_FX_sli_reverb_lowcut) * 0.000001        { normalize to 0.0 ... 1.0 }
    ~val := (~val * ~EQ_RANGE) + ~MIN_EQ_COEF    { linear interpolation between ~MIN_EQ_COEF and ~MAX_EQ_COEF }
    ~val := pow(~NI_MATH_E, ~val)                { e^x }

    $res := real_to_int(round(~val * 10.0))      { convert to integer with one "decimal" }

    { take care of value display }
    if ($res < 10000)
        set_text($SEND_FX_lbl_reverb_lowcut, $res / 10 & "." & $res mod 10 & " Hz")
    else
        { add 500 to $res for rounding purposes - matches close to how the value is displayed in Kontakt }
        set_text($SEND_FX_lbl_reverb_lowcut, $res / 10000 & "." & (($res + 500) / 1000) mod 10 & "k" & " Hz")
    end if

    set_engine_par(ENGINE_PAR_IRC_FREQ_HIGHPASS_ER, $SEND_FX_sli_reverb_lowcut, -1, SEND_REVERB_SLOT, NI_SEND_BUS)
    set_engine_par(ENGINE_PAR_IRC_FREQ_HIGHPASS_LR, $SEND_FX_sli_reverb_lowcut, -1, SEND_REVERB_SLOT, NI_SEND_BUS)

    wait(LBL_WAIT_TIME)

    if reverb_cb_state[0] = NI_CALLBACK_ID
    	set_text($SEND_FX_lbl_reverb_lowcut, "LOW CUT")
    end if
end on

on ui_control($SEND_FX_sli_reverb_hicut)

	reverb_cb_state[1] := NI_CALLBACK_ID

  	~val := int_to_real($SEND_FX_sli_reverb_hicut) * 0.000001        { normalize to 0.0 ... 1.0 }
    ~val := (~val * ~EQ_RANGE) + ~MIN_EQ_COEF    { linear interpolation between ~MIN_EQ_COEF and ~MAX_EQ_COEF }
    ~val := pow(~NI_MATH_E, ~val)                { e^x }

    $res := real_to_int(round(~val * 10.0))      { convert to integer with one "decimal" }

    { take care of value display }
    if ($res < 10000)
        //set_knob_label($Freq, $res / 10 & "." & $res mod 10)
        set_text($SEND_FX_lbl_reverb_hicut, $res / 10 & "." & $res mod 10 & " Hz")
    else
        { add 500 to $res for rounding purposes - matches close to how the value is displayed in Kontakt }
        set_text($SEND_FX_lbl_reverb_hicut, $res / 10000 & "." & (($res + 500) / 1000) mod 10 & "k" & " Hz")
    end if

	set_engine_par(ENGINE_PAR_IRC_FREQ_LOWPASS_ER, $SEND_FX_sli_reverb_hicut, -1, SEND_REVERB_SLOT, NI_SEND_BUS)
	set_engine_par(ENGINE_PAR_IRC_FREQ_LOWPASS_LR, $SEND_FX_sli_reverb_hicut, -1, SEND_REVERB_SLOT, NI_SEND_BUS)

  	wait(LBL_WAIT_TIME)

    if reverb_cb_state[1] = NI_CALLBACK_ID
    	set_text($SEND_FX_lbl_reverb_hicut, "HIGH CUT")
    end if
end on

on ui_control($SEND_FX_sli_reverb_predelay)

	reverb_cb_state[2] := NI_CALLBACK_ID
 	~val := int_to_real($SEND_FX_sli_reverb_predelay) * 0.000001    { normalize to 0.0 ... 1.0 }
    ~val := (~val * ~RANGE) + ~MIN_COEF          { linear interpolation between ~MIN_COEF and ~MAX_COEF }
    ~val := pow(~NI_MATH_E, ~val) - ~OFFSET      { e^x - ~OFFSET }

    $res := real_to_int(round(~val * 100.0))     { convert to integer with two "decimals" }

    { take care of value display (optional, can always just print with one less decimal of precision, then it's simpler) }
    if ($res < 10)
        //set_knob_label($Predelay, $res / 100 & ".0" & $res mod 100)
        set_text($SEND_FX_lbl_reverb_predelay, $res / 100 & ".0" & $res mod 100 & " ms")
    else
        if ($res < 100)
            set_text($SEND_FX_lbl_reverb_predelay, $res / 100 & "." & $res mod 100 & " ms")
        else      
            set_text($SEND_FX_lbl_reverb_predelay,$res / 100 & "." & ($res / 10) mod 10 & " ms")
        end if
    end if

    set_engine_par($ENGINE_PAR_IRC_PREDELAY, $SEND_FX_sli_reverb_predelay, -1,SEND_REVERB_SLOT, NI_SEND_BUS)

  	wait(LBL_WAIT_TIME)

    if reverb_cb_state[2] = NI_CALLBACK_ID
    	set_text($SEND_FX_lbl_reverb_predelay, "PRE DELAY")
    end if
end on

//Keyswitch system commented out 2026-11-12 - not needed for the XY pad variant, where the four corner buttons on the pad page are the articulation UI. The .nckp controls it drove are hidden, not deleted (sli_keyswitches, swi_show_keyswitch_notes and their labels on SETTINGS; lbl_art_keyswitch1..21 on the articulations page), so this is reversible: un-hide them and strip the // prefixes below. Keyswitches were notes 24-44, entirely below LOWEST_NOTE_NORMAL (48), so nothing here affected which notes sound.
