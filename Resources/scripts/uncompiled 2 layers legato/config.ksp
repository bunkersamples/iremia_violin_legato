		!note_names[i] := !notes[i mod 12] & ((i/12)-2) 
	end for

	declare const HIGHEST_POSSIBLE_KEYSWITCH := 43 //lowest note of keyswitch range

	{* LEGATO ENGINE (ported 2026-11-17 from the main legato patch, which adapted it from
	   SIPS-Legato V2.05 by R.D. Villwock, aka 'Big Bob'). See the big comment above the
	   function definitions in model.ksp for how the engine works (the New/Old two-slot
	   design). This block is just its tunable settings and per-note state - nothing here
	   runs any logic itself. *}

	declare const LGT_NO_ID := 0            { Sentinel meaning "no note here" - used for both parent/child IDs, and real Kontakt event IDs are never 0, so it is always safe to compare against }
	declare const LGT_TICK := 100           { How often (usec) the crossfade/bend loop in f.lgt_xfade() re-checks and updates - smaller = smoother fades but more CPU checks per crossfade }

	{* PORTING NOTE - this instrument's group layout is NOT the all-sustains one. Here each
	   articulation owns NUM_LAYERS*NUM_MICS groups (see art_start_group[] above), so the
	   original group count is NUM_ARTICULATIONS*NUM_LAYERS*NUM_MICS = 120, not
	   NUM_MICS*NUM_ARTICULATIONS. Using the all-sustains formula would give 60 and point the
	   phase-aligned set at the middle of the ORIGINAL groups. *}
	declare const LGT_PHASE_GROUP_OFFSET := NUM_ARTICULATIONS*NUM_LAYERS*NUM_MICS  { group-index offset to the phase-aligned duplicate group set, added when $ADSR_swi_phase indicates phase-align is ON }
	declare lgt_phase_grp_ofs  { 0 or LGT_PHASE_GROUP_OFFSET, computed once per on note, added to every allow_group() group index }
	declare lgt_note_lo        { lowest in-range note for the current articulation (normal or harmonics range) }
	declare lgt_note_hi        { highest in-range note for the current articulation (normal or harmonics range) }

	{* Per-note-event state. Everything here is sized [2] - one slot for "New" (the most recently
	   played note) and one for "Old" (whatever it is transitioning from). lgt.new_idx (0 or 1)
	   says which of the two is currently "New"; the other index (1 - lgt.new_idx) is always
	   "Old". See the big comment at the top of the LEGATO ENGINE section in model.ksp. *}
	family lgt
		declare parent[2]    { the REAL key-press event ID for each slot - used in on release to match a key-lift back to New or Old }
		declare child[2]     { the event ID of the note WE generated via play_note() - this is what actually makes sound, and what fade_in/fade_out/change_tune/note_off all act on }
		declare note[2]      { MIDI note number held in each slot }
		declare vel[2]       { velocity held in each slot }
		declare pedal[2]     { true if that slot's key-up arrived while the sustain pedal was down, and is waiting for pedal-up to actually end }
		declare tune[2]      { the bend amount (millicents) last applied to that slot's note, so f.lgt_do_bend() can apply the next tick as a delta rather than stacking }
		declare new_idx      { 0 or 1: which of the two slots above is currently "New" }
		declare ref_time     { ENGINE_UPTIME of the most recent note-on, for offset calc }
		declare offset       { sample-start offset to use for the next generated note, usec }
		declare fade_out_ticks
		declare fade_in_ticks
		declare seg2_ticks
		declare bend_ticks
		declare bend_amount
		declare bend_step
		declare active       { true while a crossfade is in progress }
		declare busy         { re-entrancy guard for f.lgt_stop_fade }
		declare pedal_down   { current sustain pedal state }
	end family

	lgt.parent[0] := LGT_NO_ID
	lgt.parent[1] := LGT_NO_ID
	lgt.pedal_down := false


end macro

