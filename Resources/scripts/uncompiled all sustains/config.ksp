		//Special FX
		!IR_names[16] := get_folder($GET_FOLDER_FACTORY_DIR) & "presets/effects/convolution/11 Unsusual Reverbs/IR Samples/Bubbly Freq Flange.wav"
		!IR_names[17] := get_folder($GET_FOLDER_FACTORY_DIR) & "presets/effects/convolution/11 Unsusual Reverbs/IR Samples/Zipper Up.wav"
		!IR_names[18] := get_folder($GET_FOLDER_FACTORY_DIR) & "presets/effects/convolution/11 Unsusual Reverbs/IR Samples/Crystal Caves.wav"
		!IR_names[19] := get_folder($GET_FOLDER_FACTORY_DIR) & "presets/effects/convolution/11 Unsusual Reverbs/IR Samples/CrystalGyroscope.wav"
		!IR_names[20] := get_folder($GET_FOLDER_FACTORY_DIR) & "presets/effects/convolution/15 Special Effects/Mix/IR Samples/Dry Ice.wav"
